<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tailscale-route.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/tailscale-route-helper</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/var/log/tailscale-route-helper.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/tailscale-route-helper.error.log</string>
</dict>
</plist>
